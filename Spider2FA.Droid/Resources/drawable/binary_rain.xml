<?xml version="1.0" encoding="utf-8"?>
<!--
  Binary rain background — black with red falling characters.
  Used behind the main authenticator list (subtle, slow) and
  behind the About/Splash screens (loud, fast).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/spider_black" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/binary_rain_pattern"
            android:gravity="fill"
            android:tileMode="repeat"
            android:alpha="0.18" />
    </item>
</layer-list>
